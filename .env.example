# Copy to .env to customize Docker Compose deployment

# Local bind IP (use 0.0.0.0 to expose on LAN / remote server)
TELEMETRY_BIND_IP=127.0.0.1

# Host port exposed by Docker
TELEMETRY_PORT=8765

# Path to host ~/.gemini directory containing antigravity/conversations/*.db
# Examples:
#   macOS/Linux: /home/yourname/.gemini  (or ~/.gemini)
#   Windows    : C:/Users/yourname/.gemini
GEMINI_HOME_HOST=~/.gemini

# Container UID/GID (match host `id -u` and `id -g` on Linux if ~/.gemini is private)
PUID=1000
PGID=1000

# Set to 1 to preview with built-in demo data
TELEMETRY_DEMO=0

# Timezone used for "Today", "18:00+", and 24-hour rhythm charts
TZ=Asia/Shanghai
